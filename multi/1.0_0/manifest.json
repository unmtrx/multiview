{
   "manifest_version": 3,
   "name": "MultiView: Split Screen Tab Extension",
   "version": "1.0",
   "action": {
      "default_icon": "icon.png",
      "default_popup": "popup.html"
   },
   "content_scripts": [
      {
         "js": [ "content.js" ],
         "matches": [ "<all_urls>" ],
         "all_frames": true 
      }
   ],
   "host_permissions": [
      "<all_urls>"
   ],
   "icons": {
      "16": "icon_16.png",
      "48": "icon_48.png",
      "128": "icon_128.png"
   },
   "permissions": [
      "storage"
   ]
}